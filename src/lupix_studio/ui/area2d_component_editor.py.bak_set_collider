from __future__ import annotations

from pathlib import Path

from PySide6.QtCore import Signal
from PySide6.QtWidgets import (
    QCheckBox,
    QComboBox,
    QDoubleSpinBox,
    QFormLayout,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QPushButton,
    QScrollArea,
    QStyle,
    QToolButton,
    QVBoxLayout,
    QWidget,
)

from lupix_studio.scene.model import (
    Area2DAction,
    Area2DComponent,
    SceneEntity,
    SceneResource,
)


class Area2DComponentEditor(QWidget):
    """Editor do componente Area2D."""

    area2d_changed = Signal(str)

    def __init__(self) -> None:
        super().__init__()

        self.project_root: Path | None = None
        self.scene: SceneResource | None = None
        self.entity: SceneEntity | None = None
        self._updating = False

        self.status_label = QLabel(
            "Nenhuma entidade selecionada."
        )
        self.status_label.setWordWrap(True)

        self.add_button = QPushButton(
            "Adicionar Area2D"
        )

        self.enabled_checkbox = QCheckBox(
            "Ativa"
        )
        self.detect_player_checkbox = QCheckBox(
            "Detectar Player"
        )
        self.debug_visible_checkbox = QCheckBox(
            "Mostrar área no editor"
        )

        self.width_spin = self._size_spin(64.0)
        self.height_spin = self._size_spin(64.0)
        self.offset_x_spin = self._offset_spin()
        self.offset_y_spin = self._offset_spin()

        size_form = QFormLayout()
        size_form.addRow(
            "Largura:",
            self.width_spin,
        )
        size_form.addRow(
            "Altura:",
            self.height_spin,
        )
        size_form.addRow(
            "Offset X:",
            self.offset_x_spin,
        )
        size_form.addRow(
            "Offset Y:",
            self.offset_y_spin,
        )

        self.events_title = QLabel(
            "Ao entrar"
        )
        self.events_title.setStyleSheet(
            "font-weight: 600; margin-top: 8px;"
        )

        self.trigger_once_checkbox = QCheckBox(
            "Executar apenas uma vez"
        )

        self.actions_widget = QWidget()
        self.actions_layout = QVBoxLayout(
            self.actions_widget
        )
        self.actions_layout.setContentsMargins(
            0,
            0,
            0,
            0,
        )
        self.actions_layout.setSpacing(6)

        self.actions_scroll = QScrollArea()
        self.actions_scroll.setWidgetResizable(True)
        self.actions_scroll.setMinimumHeight(170)
        self.actions_scroll.setWidget(
            self.actions_widget
        )

        self.add_action_button = QPushButton(
            "+ Adicionar ação"
        )

        self.hint_label = QLabel(
            "As ações são executadas de cima para baixo."
        )
        self.hint_label.setWordWrap(True)

        self.remove_button = QPushButton(
            "Remover Area2D"
        )

        layout = QVBoxLayout(self)
        layout.setContentsMargins(
            0,
            0,
            0,
            0,
        )
        layout.setSpacing(8)
        layout.addWidget(self.status_label)
        layout.addWidget(self.add_button)
        layout.addWidget(self.enabled_checkbox)
        layout.addLayout(size_form)
        layout.addWidget(
            self.detect_player_checkbox
        )
        layout.addWidget(
            self.debug_visible_checkbox
        )
        layout.addWidget(self.events_title)
        layout.addWidget(
            self.trigger_once_checkbox
        )
        layout.addWidget(self.actions_scroll)
        layout.addWidget(
            self.add_action_button
        )
        layout.addWidget(self.hint_label)
        layout.addWidget(self.remove_button)
        layout.addStretch()

        self.add_button.clicked.connect(
            self._add_area2d
        )
        self.remove_button.clicked.connect(
            self._remove_area2d
        )
        self.add_action_button.clicked.connect(
            self._add_action
        )

        for control in (
            self.enabled_checkbox,
            self.detect_player_checkbox,
            self.debug_visible_checkbox,
            self.trigger_once_checkbox,
        ):
            control.toggled.connect(
                self._apply
            )

        for spin in (
            self.width_spin,
            self.height_spin,
            self.offset_x_spin,
            self.offset_y_spin,
        ):
            spin.valueChanged.connect(
                self._apply
            )

        self.set_context(
            None,
            None,
            None,
        )

    @staticmethod
    def _size_spin(
        value: float,
    ) -> QDoubleSpinBox:
        spin = QDoubleSpinBox()
        spin.setRange(
            1.0,
            100000.0,
        )
        spin.setDecimals(1)
        spin.setValue(value)
        return spin

    @staticmethod
    def _offset_spin() -> QDoubleSpinBox:
        spin = QDoubleSpinBox()
        spin.setRange(
            -100000.0,
            100000.0,
        )
        spin.setDecimals(1)
        return spin

    def set_context(
        self,
        scene: SceneResource | None,
        entity: SceneEntity | None,
        project_root: Path | None = None,
    ) -> None:
        self.scene = scene
        self.entity = entity

        if project_root is not None:
            self.project_root = Path(
                project_root
            ).resolve()
        elif scene is None:
            self.project_root = None

        self._refresh()

    def refresh_scene_list(self) -> None:
        self._refresh_actions()

    def _refresh(self) -> None:
        self._updating = True

        try:
            if self.entity is None:
                self.status_label.setText(
                    "Nenhuma entidade selecionada."
                )
                self.add_button.setVisible(False)
                self._set_controls_visible(False)
                return

            area = self.entity.area2d

            if area is None:
                self.status_label.setText(
                    "Esta entidade ainda não possui Area2D."
                )
                self.add_button.setVisible(True)
                self._set_controls_visible(False)
                return

            self.status_label.setText(
                "Area2D anexada a esta entidade."
            )
            self.add_button.setVisible(False)
            self._set_controls_visible(True)

            self.enabled_checkbox.setChecked(
                area.enabled
            )
            self.width_spin.setValue(
                area.width
            )
            self.height_spin.setValue(
                area.height
            )
            self.offset_x_spin.setValue(
                area.offset_x
            )
            self.offset_y_spin.setValue(
                area.offset_y
            )
            self.detect_player_checkbox.setChecked(
                area.detect_player
            )
            self.debug_visible_checkbox.setChecked(
                area.debug_visible
            )
            self.trigger_once_checkbox.setChecked(
                area.trigger_once
            )

            self._refresh_actions()

        finally:
            self._updating = False

    def _set_controls_visible(
        self,
        visible: bool,
    ) -> None:
        for widget in (
            self.enabled_checkbox,
            self.width_spin,
            self.height_spin,
            self.offset_x_spin,
            self.offset_y_spin,
            self.detect_player_checkbox,
            self.debug_visible_checkbox,
            self.events_title,
            self.trigger_once_checkbox,
            self.actions_scroll,
            self.add_action_button,
            self.hint_label,
            self.remove_button,
        ):
            widget.setVisible(visible)

    def _clear_actions_ui(self) -> None:
        while self.actions_layout.count():
            item = self.actions_layout.takeAt(0)
            widget = item.widget()

            if widget is not None:
                widget.deleteLater()

    def _refresh_actions(self) -> None:
        self._clear_actions_ui()

        if (
            self.entity is None
            or self.entity.area2d is None
        ):
            return

        actions = (
            self.entity.area2d.on_enter_actions
        )

        if not actions:
            empty = QLabel(
                "Nenhuma ação configurada."
            )
            empty.setWordWrap(True)
            self.actions_layout.addWidget(
                empty
            )
            return

        for index, action in enumerate(actions):
            row = self._build_action_row(
                index,
                action,
            )
            self.actions_layout.addWidget(
                row
            )

        self.actions_layout.addStretch()

    def _build_action_row(
        self,
        index: int,
        action: Area2DAction,
    ) -> QWidget:
        container = QWidget()
        outer = QVBoxLayout(container)
        outer.setContentsMargins(
            6,
            6,
            6,
            6,
        )
        outer.setSpacing(5)

        header = QHBoxLayout()

        number = QLabel(
            f"{index + 1}."
        )

        action_combo = QComboBox()
        action_combo.addItem(
            "Mostrar mensagem",
            "show_message",
        )
        action_combo.addItem(
            "Aguardar",
            "wait",
        )
        action_combo.addItem(
            "Teleportar jogador",
            "teleport_player",
        )
        action_combo.addItem(
            "Trocar cena",
            "change_scene",
        )

        selected = action_combo.findData(
            action.action
        )
        action_combo.setCurrentIndex(
            max(
                0,
                selected,
            )
        )

        up_button = QToolButton()
        down_button = QToolButton()
        remove_button = QToolButton()

        up_button.setText("↑")
        down_button.setText("↓")

        arrow_style = (
            "QToolButton {"
            " color: #f2f2f2;"
            " background-color: #2a2d33;"
            " border: 1px solid #3a3e46;"
            " border-radius: 4px;"
            " font-size: 18px;"
            " font-weight: 700;"
            " padding: 0px;"
            " }"
            " QToolButton:hover {"
            " color: #ffffff;"
            " background-color: #343840;"
            " border-color: #555b66;"
            " }"
            " QToolButton:pressed {"
            " background-color: #202329;"
            " }"
            " QToolButton:disabled {"
            " color: #666b73;"
            " background-color: #24272c;"
            " border-color: #30343a;"
            " }"
        )

        up_button.setStyleSheet(arrow_style)
        down_button.setStyleSheet(arrow_style)
        remove_button.setIcon(
            self.style().standardIcon(
                QStyle.StandardPixmap.SP_TrashIcon
            )
        )

        up_button.setToolTip("Mover ação para cima")
        down_button.setToolTip("Mover ação para baixo")
        remove_button.setToolTip("Excluir ação")

        for button in (
            up_button,
            down_button,
            remove_button,
        ):
            button.setFixedSize(
                34,
                30,
            )

        up_button.setEnabled(
            index > 0
        )
        down_button.setEnabled(
            index
            < len(
                self.entity.area2d.on_enter_actions
            )
            - 1
        )

        header.addWidget(number)
        header.addWidget(
            action_combo,
            1,
        )
        header.addWidget(up_button)
        header.addWidget(down_button)
        header.addWidget(remove_button)

        outer.addLayout(header)

        details = QWidget()
        details_layout = QFormLayout(
            details
        )
        details_layout.setContentsMargins(
            24,
            0,
            0,
            0,
        )

        message_edit = QLineEdit()
        message_edit.setPlaceholderText(
            "Texto exibido ao jogador..."
        )
        message_edit.setText(
            action.message_text
        )

        wait_spin = QDoubleSpinBox()
        wait_spin.setRange(
            0.0,
            3600.0,
        )
        wait_spin.setDecimals(2)
        wait_spin.setSingleStep(0.25)
        wait_spin.setSuffix(" s")
        wait_spin.setValue(
            action.wait_seconds
        )

        player_x_spin = self._offset_spin()
        player_y_spin = self._offset_spin()

        player_x_spin.setValue(
            action.player_x
        )
        player_y_spin.setValue(
            action.player_y
        )

        scene_combo = QComboBox()
        scene_combo.setMinimumWidth(180)
        self._populate_scene_combo(
            scene_combo,
            action.target_scene,
        )

        details_layout.addRow(
            "Mensagem:",
            message_edit,
        )
        details_layout.addRow(
            "Tempo:",
            wait_spin,
        )
        details_layout.addRow(
            "Posição X:",
            player_x_spin,
        )
        details_layout.addRow(
            "Posição Y:",
            player_y_spin,
        )
        details_layout.addRow(
            "Cena destino:",
            scene_combo,
        )

        outer.addWidget(details)

        def update_details() -> None:
            kind = str(
                action_combo.currentData()
                or ""
            )

            message_edit.setVisible(
                kind == "show_message"
            )
            details_layout.labelForField(
                message_edit
            ).setVisible(
                kind == "show_message"
            )

            wait_spin.setVisible(
                kind == "wait"
            )
            details_layout.labelForField(
                wait_spin
            ).setVisible(
                kind == "wait"
            )

            player_x_spin.setVisible(
                kind == "teleport_player"
            )
            details_layout.labelForField(
                player_x_spin
            ).setVisible(
                kind == "teleport_player"
            )

            player_y_spin.setVisible(
                kind == "teleport_player"
            )
            details_layout.labelForField(
                player_y_spin
            ).setVisible(
                kind == "teleport_player"
            )

            scene_combo.setVisible(
                kind == "change_scene"
            )
            details_layout.labelForField(
                scene_combo
            ).setVisible(
                kind == "change_scene"
            )

        def save_row() -> None:
            if self._updating:
                return

            if (
                self.entity is None
                or self.entity.area2d is None
            ):
                return

            if index >= len(
                self.entity.area2d.on_enter_actions
            ):
                return

            current = (
                self.entity.area2d.on_enter_actions[
                    index
                ]
            )

            current.action = str(
                action_combo.currentData()
                or "none"
            )
            current.message_text = (
                message_edit.text()
            )
            current.wait_seconds = (
                wait_spin.value()
            )
            current.target_scene = str(
                scene_combo.currentData()
                or ""
            )
            current.player_x = (
                player_x_spin.value()
            )
            current.player_y = (
                player_y_spin.value()
            )

            update_details()
            self._sync_legacy_fields()
            self.area2d_changed.emit(
                self.entity.id
            )

        action_combo.currentIndexChanged.connect(
            save_row
        )
        message_edit.editingFinished.connect(
            save_row
        )
        wait_spin.valueChanged.connect(
            save_row
        )
        player_x_spin.valueChanged.connect(
            save_row
        )
        player_y_spin.valueChanged.connect(
            save_row
        )
        scene_combo.currentIndexChanged.connect(
            save_row
        )

        up_button.clicked.connect(
            lambda: self._move_action(
                index,
                -1,
            )
        )
        down_button.clicked.connect(
            lambda: self._move_action(
                index,
                1,
            )
        )
        remove_button.clicked.connect(
            lambda: self._remove_action(
                index
            )
        )

        update_details()

        return container

    def _populate_scene_combo(
        self,
        combo: QComboBox,
        selected_path: str = "",
    ) -> None:
        combo.clear()
        combo.addItem(
            "Selecione uma cena...",
            "",
        )

        if self.project_root is None:
            return

        scenes_dir = (
            self.project_root
            / "scenes"
        )

        if not scenes_dir.exists():
            return

        scene_files = sorted(
            scenes_dir.rglob("*.scene"),
            key=lambda path: str(
                path.relative_to(
                    scenes_dir
                )
            ).lower(),
        )

        normalized_selected = (
            selected_path.replace(
                "\\",
                "/",
            )
        )

        selected_index = 0

        for scene_path in scene_files:
            relative_project = (
                scene_path.relative_to(
                    self.project_root
                )
            )

            stored_path = (
                relative_project.as_posix()
            )

            display_name = (
                scene_path.relative_to(
                    scenes_dir
                )
                .with_suffix("")
                .as_posix()
            )

            combo.addItem(
                display_name,
                stored_path,
            )

            if (
                stored_path
                == normalized_selected
            ):
                selected_index = (
                    combo.count()
                    - 1
                )

        combo.setCurrentIndex(
            selected_index
        )

    def _add_action(self) -> None:
        if (
            self.entity is None
            or self.entity.area2d is None
        ):
            return

        self.entity.area2d.on_enter_actions.append(
            Area2DAction(
                action="show_message"
            )
        )

        self._sync_legacy_fields()
        self._refresh_actions()

        self.area2d_changed.emit(
            self.entity.id
        )

    def _remove_action(
        self,
        index: int,
    ) -> None:
        if (
            self.entity is None
            or self.entity.area2d is None
        ):
            return

        actions = (
            self.entity.area2d.on_enter_actions
        )

        if not (
            0 <= index < len(actions)
        ):
            return

        actions.pop(index)

        self._sync_legacy_fields()
        self._refresh_actions()

        self.area2d_changed.emit(
            self.entity.id
        )

    def _move_action(
        self,
        index: int,
        direction: int,
    ) -> None:
        if (
            self.entity is None
            or self.entity.area2d is None
        ):
            return

        actions = (
            self.entity.area2d.on_enter_actions
        )

        target = index + direction

        if not (
            0 <= index < len(actions)
            and 0 <= target < len(actions)
        ):
            return

        actions[index], actions[target] = (
            actions[target],
            actions[index],
        )

        self._sync_legacy_fields()
        self._refresh_actions()

        self.area2d_changed.emit(
            self.entity.id
        )

    def _sync_legacy_fields(self) -> None:
        if (
            self.entity is None
            or self.entity.area2d is None
        ):
            return

        area = self.entity.area2d

        area.on_enter_action = "none"
        area.target_scene = ""
        area.message_text = ""

        actions = area.on_enter_actions

        if len(actions) == 1:
            action = actions[0]

            area.on_enter_action = (
                action.action
            )
            area.target_scene = (
                action.target_scene
            )
            area.message_text = (
                action.message_text
            )
            return

        if (
            len(actions) == 3
            and actions[0].action
            == "show_message"
            and actions[1].action
            == "wait"
            and actions[2].action
            == "change_scene"
        ):
            area.on_enter_action = (
                "message_change_scene"
            )
            area.message_text = (
                actions[0].message_text
            )
            area.target_scene = (
                actions[2].target_scene
            )

    def _add_area2d(self) -> None:
        if self.entity is None:
            return

        if self.entity.area2d is not None:
            return

        self.entity.area2d = (
            Area2DComponent()
        )
        self.entity.refresh_kind()
        self._refresh()

        self.area2d_changed.emit(
            self.entity.id
        )

    def _remove_area2d(self) -> None:
        if self.entity is None:
            return

        self.entity.area2d = None
        self.entity.refresh_kind()
        self._refresh()

        self.area2d_changed.emit(
            self.entity.id
        )

    def _apply(self) -> None:
        if self._updating:
            return

        if (
            self.entity is None
            or self.entity.area2d is None
        ):
            return

        area = self.entity.area2d

        area.enabled = (
            self.enabled_checkbox.isChecked()
        )
        area.width = max(
            1.0,
            self.width_spin.value(),
        )
        area.height = max(
            1.0,
            self.height_spin.value(),
        )
        area.offset_x = (
            self.offset_x_spin.value()
        )
        area.offset_y = (
            self.offset_y_spin.value()
        )
        area.detect_player = (
            self.detect_player_checkbox.isChecked()
        )
        area.debug_visible = (
            self.debug_visible_checkbox.isChecked()
        )
        area.trigger_once = (
            self.trigger_once_checkbox.isChecked()
        )

        self._sync_legacy_fields()

        self.area2d_changed.emit(
            self.entity.id
        )
